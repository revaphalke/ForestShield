{
  "name": "forestshield",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8081",
    "build": "npm run generate:c-config && vite build",
    "build:dev": "npm run generate:c-config && vite build --mode development",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "generate:c-config": "node scripts/generate-c-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run generate:c-config && node --experimental-strip-types --test src/lib/pathfinder.test.ts src/lib/risk-model.test.ts src/lib/engine.test.ts src/lib/step-flow.test.ts scripts/generate-c-config.test.mjs scripts/c-parity.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
